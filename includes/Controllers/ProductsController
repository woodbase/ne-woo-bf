<?php

namespace NEBF\Controllers;

use NEBF\Models\ProductRepository;
use NEBF\Services\ProductSyncService;

if (!defined('ABSPATH')) {
    exit;
}

/**
 * Handles product management admin page.
 */
class ProductsController extends AbstractAdminController {

    /**
     * Process request and render view.
     */
    public function handle(): void {

        $repo = new ProductRepository();

        $this->handle_actions($repo);

        $search = sanitize_text_field($_GET['s'] ?? '');
        $page   = max(1, intval($_GET['paged'] ?? 1));

        $data = $repo->get_paginated($page, 10, $search);

        $this->render('products', [
            'products'     => $data['items'],
            'total'        => $data['total'],
            'total_pages'  => ceil($data['total'] / 10),
            'current_page' => $page,
            'search'       => $search,
        ]);
    }

    /**
     * Handle form actions like syncing.
     *
     * @param ProductRepository $repo
     */
    private function handle_actions(ProductRepository $repo): void {

        if (
            isset($_POST['nebf_sync_all']) &&
            check_admin_referer('nebf_sync_products')
        ) {
            $sync = new ProductSyncService();
            $sync->sync_multiple($repo->get_all());

            $this->notices->add(
                __('Products synced successfully.', 'nebf-mvc'),
                'success'
            );
        }
    }
}
